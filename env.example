# Clinqy settings. Copy this file to ~/.config/clinqy/env and uncomment what you need:
#
#   mkdir -p ~/.config/clinqy && cp env.example ~/.config/clinqy/env && chmod 600 ~/.config/clinqy/env
#
# One KEY=value per line, no comment after the value. Lines starting with # are ignored. Restart Clinqy after editing.


# ─── 1. Pick ONE model option ────────────────────────────────────────────────────────────────────

# ── A coding CLI you're already logged into (no key needed) ──
# Claude Code is the default: leave every PROVIDER line commented out to use it.
# PROVIDER=claude-cli
# Codex CLI: npm i -g @openai/codex, then `codex login`
# PROVIDER=codex-cli
# Gemini CLI: npm i -g @google/gemini-cli, then run `gemini` once to log in
# PROVIDER=gemini-cli

# ── An API key ──
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# PROVIDER=openai
# OPENAI_API_KEY=sk-...

# PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...

# ── A local or self-hosted model (must be a vision model) ──
# PROVIDER=ollama
# LOCAL_MODEL=qwen3-vl
# OPENAI_BASE_URL=http://localhost:11434/v1

# PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=...
# LOCAL_MODEL=...


# ─── 2. Optional: models and speed ───────────────────────────────────────────────────────────────

# sonnet / haiku / opus pick each provider's matching tier (see the README), or use any model id.
# The agent
# CLAUDE_MODEL=sonnet
# Helper for routine steps; off to use only CLAUDE_MODEL
# FAST_MODEL=haiku
# low is faster per step; also the reasoning effort for OpenAI/Gemini
# CLAUDE_EFFORT=low


# ─── 3. Optional: everything else ────────────────────────────────────────────────────────────────

# Only if a CLI isn't found on its own
# CLAUDE_PATH=/path/to/claude
# CODEX_PATH=/path/to/codex
# GEMINI_PATH=/path/to/gemini
# Apple dictation only, skips the local Whisper model
# VOICE_ENGINE=apple
# auto | en | hinglish | hi | any Whisper language code
# VOICE_LANGUAGE=auto
# WHISPER_MODEL=large-v3-v20240930_turbo_632MB
# Always ask the model, even when a saved workflow matches
# WORKFLOW_FIRST=off
# Don't keep the mic open after a spoken task
# FOLLOW_UP=off
# The fast helper only takes over when the agent hands it steps
# FAST_AUTO=off
# Record runs as offline replay fixtures
# REPLAY_RECORD=on
