# Clinqy settings (the same file and options as on the Mac). This file lives at:
#
#   %USERPROFILE%\.config\clinqy\env
#
# One KEY=value per line, no comment after the value. Lines starting with # are ignored.
# Changes apply to the next request (no restart needed).


# ─── 1. Pick ONE model option ────────────────────────────────────────────────────────────────────

# ── A coding CLI you're already logged into (no key needed) ──
# Claude Code is the default: leave every PROVIDER line commented out to use it.
#   Install: winget install Anthropic.ClaudeCode   (then run `claude` once and log in)
# PROVIDER=claude-cli

# Antigravity CLI (agy): install Antigravity, run `agy` once and log in
# PROVIDER=agy-cli

# Codex CLI: npm i -g @openai/codex, then `codex login`
# PROVIDER=codex-cli

# ── An API key ──
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# PROVIDER=openai
# OPENAI_API_KEY=sk-...

# PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...

# ── A local or self-hosted model (must be a vision model) ──
# PROVIDER=ollama
# LOCAL_MODEL=qwen3-vl
# OPENAI_BASE_URL=http://localhost:11434/v1

# PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=...
# LOCAL_MODEL=...


# ─── 2. Optional: models and speed ───────────────────────────────────────────────────────────────

# sonnet / haiku / opus pick each provider's matching tier, or use any model id.
# CLAUDE_MODEL=sonnet
# AGY_MODEL=gemini-3.8-flash
# low is faster per step; also the reasoning effort for OpenAI/Gemini/Agy
# CLAUDE_EFFORT=low
# AGY_EFFORT=low


# ─── 3. Optional: everything else ────────────────────────────────────────────────────────────────

# Push-to-talk: hold to speak, let go to send (modifiers + one key: a letter, digit, space or F1-F12; "off" turns it off)
# TALK_HOTKEY=ctrl+h

# The summon key: tap to open the command bar. Modifier-only chords:
# ctrl+alt (default, uses the LEFT Alt so AltGr typing never triggers it), ctrl+win, ctrl+shift, alt+win
# HOTKEY=ctrl+alt

# Only if a CLI isn't found on its own
# CLAUDE_PATH=C:\path\to\claude.exe
# AGY_PATH=C:\path\to\agy.exe
# CODEX_PATH=C:\path\to\codex.cmd

# Voice (also in the tray: Voice language): en (default) | hinglish | hi | auto (detects it, ~5 s slower) | any Whisper code
# VOICE_LANGUAGE=en
# The on-device Whisper model (downloaded once): small-q5_1 (default: ~1.5 s on a laptop CPU),
# large-v3-turbo-q5_0 (most accurate, much slower without a GPU), base.en (fastest, English only)
# WHISPER_MODEL=small-q5_1

# Always ask the model, even when a saved workflow matches
# WORKFLOW_FIRST=off
# Keep the mic open for 5 s after a spoken task, for a follow-up ("now email that to Rahul")
# FOLLOW_UP=on
# Don't start the first action while the model is still writing its reply
# EARLY_START=off
# Record runs as offline replay fixtures
# REPLAY_RECORD=on
# ffmpeg for video/audio jobs, when it isn't on PATH (winget install Gyan.FFmpeg)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
