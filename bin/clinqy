#!/bin/zsh
# clinqy — drive the Clinqy app from a terminal or any coding agent (Claude Code, Codex, Cursor, …).
#
#   clinqy qa <test.md | folder | "inline test"> ... [--relearn] [--model sonnet|opus|haiku] [--json]
#       Run UI tests. The first run uses the model and compiles a deterministic script (saved in
#       .clinqy/ next to the test); later runs replay it with no model, healing only broken steps.
#       Test files: optional "# Title", then one step per line; lines starting with Expect/Check/Verify
#       are assertions. Exit code 0 = all passed, 1 = something failed.
#   clinqy run [--dry|--test] "<task>"  Do a task like one asked in the app (history, and it carries on by itself when it
#                                    runs out of steps). --dry: point at each click/keystroke, don't do it. --test: a
#                                    throwaway run (not saved, no carrying on), as for checking a page.
#   clinqy workflow <name> [k=v ...] Replay a saved workflow with parameters, no model.
#   clinqy workflows                 List saved workflows.
#   clinqy stats [days] [--last]     Success rate, model vs action time per turn, top failure reasons (default: 7 days).
#   clinqy mcp                       Serve Clinqy as an MCP server on stdio (claude mcp add clinqy -- clinqy mcp).
#   clinqy watch <app> <text> [--gone] [--timeout s]   Wait for text to appear in (or vanish from) an app.
#   clinqy replay <fixture.json|folder> [--bless]      Re-check recorded runs offline (tests/replay).
#   clinqy memory ["request"] [--app Name] [--site host]   How memory is organised (profile, notes per site/app);
#                                    with a request: exactly which facts it would be sent.
#   clinqy page [read|url]           What's in the focused browser tab, via the extension (read-only):
#                                    its elements (w-ids, fields, values, errors) and visible text; read = full text.
#   clinqy extension reload          Reload the browser extension from disk.
set -u
LOG=~/Library/Logs/Clinqy/agent.log
WF=~/Library/Application\ Support/Clinqy/workflows.json
TOKEN=$(cat ~/.config/clinqy/cli-token 2>/dev/null)
enc() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }

ensure_app() {
  pgrep -x Clinqy >/dev/null && return
  open -b com.amritnigam.clinqy 2>/dev/null || { echo "Clinqy isn't installed (run ./build.sh in the repo)"; exit 2; }
  sleep 3
}

wait_log() {   # wait for a run started after line $1 to finish; print its steps
  local start=$1
  for i in $(seq 1 14400); do   # long tasks (a whole lab) run for hours
    pgrep -xq Clinqy || break
    sleep 1
    # Finished when the newest end/restart line is an end (✓/✗) that no auto-continue followed within a few seconds.
    local last=$(tail -n +$((start+1)) $LOG 2>/dev/null | grep -E "\] (✓|✗)|\] auto-continue " | tail -1)
    if print -r -- "$last" | grep -qE "\] (✓|✗)"; then
      sleep 3
      [[ $(tail -n +$((start+1)) $LOG | grep -E "\] (✓|✗)|\] auto-continue " | tail -1) == "$last" ]] && break
    fi
  done
  tail -n +$((start+1)) $LOG | grep -E "→|\] (✓|✗)" | sed 's/^\[ *[0-9.]*s\] *//'
  tail -n +$((start+1)) $LOG | grep -E "\] (✓|✗)" | tail -1 | grep -qE "\] ✓"   # the last run's outcome
}

cmd=${1:-help}; shift 2>/dev/null
case $cmd in
  qa)
    relearn=0 model="" json=0 targets=()
    while (( $# )); do
      case $1 in
        --relearn) relearn=1 ;;
        --model) shift; model=${1:-} ;;
        --json) json=1 ;;
        *) targets+=("$1") ;;
      esac
      shift
    done
    (( ${#targets} )) || { echo "usage: clinqy qa <test.md|folder|\"inline test\"> [--relearn] [--model m] [--json]"; exit 2; }
    ensure_app
    files=()
    for t in $targets; do
      if [[ -d $t ]]; then files+=(${t}/**/*.(md|txt)(N:A)); files=(${files:#*/.clinqy/*})
      elif [[ -f $t ]]; then files+=(${t:A})
      else files+=("inline:$t"); fi
    done
    failed=0 reports=()
    for f in $files; do
      out=$(mktemp -t clinqy-qa).json; rm -f $out
      if [[ $f == inline:* ]]; then q="text=$(enc "${f#inline:}")"; else q="path=$(enc "$f")"; fi
      [[ -n $model ]] && q+="&model=$(enc $model)"
      (( relearn )) && q+="&relearn=1"
      open -g "clinqy://qa?$q&out=$(enc $out)&token=$TOKEN"
      for i in $(seq 1 900); do [[ -s $out ]] && break; sleep 1; done
      [[ -s $out ]] || { echo "TIMEOUT  ${f#inline:}"; failed=1; continue; }
      reports+=($out)
      python3 - "$out" "$json" <<'PY' || failed=1
import json, sys
r = json.load(open(sys.argv[1]))
if sys.argv[2] == "1":
    print(json.dumps(r)); sys.exit(0 if r["passed"] else 1)
mark = "PASS" if r["passed"] else "FAIL"
print(f'{mark}  {r["name"]}  ({r["mode"]}, {r["durationMs"]/1000:.1f}s)')
for c in r["checks"]:
    print(f'   {"✓" if c["pass"] else "✗"} {c["text"]}' + (f'  — {c["note"]}' if c["note"] and not c["pass"] else ""))
if not r["passed"]:
    for s in r["steps"][-6:]: print(f'   · {s}')
    if r["message"]: print(f'   {r["message"]}')
sys.exit(0 if r["passed"] else 1)
PY
    done
    exit $failed ;;
  run)
    ensure_app
    flags=""
    while [[ ${1:-} == --dry || ${1:-} == --test ]]; do
      [[ $1 == --dry ]] && flags+="&dry=1"
      [[ $1 == --test ]] && flags+="&test=1"
      shift
    done
    start=$(wc -l < $LOG 2>/dev/null || echo 0)
    open -g "clinqy://run?task=$(enc "$*")$flags&token=$TOKEN"
    wait_log $start ;;
  workflow)
    ensure_app
    name=${1:-}; shift 2>/dev/null
    q="name=$(enc "$name")"
    for kv in "$@"; do q+="&$(enc "${kv%%=*}")=$(enc "${kv#*=}")"; done
    start=$(wc -l < $LOG 2>/dev/null || echo 0)
    open -g "clinqy://workflow?$q&token=$TOKEN"
    wait_log $start ;;
  workflows)
    python3 - "$WF" <<'PY'
import json, os, sys
p = sys.argv[1]
for w in (json.load(open(p)) if os.path.exists(p) else []):
    extra = f' · daily {w["schedule"]}' if w.get("schedule") else ""
    params = f' ({", ".join(w["params"])})' if w.get("params") else ""
    print(f'{w["name"]}{params} — {len(w["steps"])} steps, run {w.get("runs", 0)}×{extra}')
PY
    ;;
  page)
    ensure_app
    id="p$$-$RANDOM"; f=~/Library/Application\ Support/Clinqy/cli/$id.txt
    open -g "clinqy://browser?cmd=${1:-page}&id=$id&token=$TOKEN"
    for i in $(seq 1 60); do [[ -f $f ]] && break; sleep 0.25; done
    [[ -f $f ]] || { echo "No answer from Clinqy (is the browser open with the extension loaded?)"; exit 1; }
    out=$(<$f); rm -f $f; print -r -- "$out"
    [[ $out == ERROR:* ]] && exit 1; exit 0 ;;
  extension)
    ensure_app
    open -g "clinqy://reload-extension?token=$TOKEN"; echo "Asked the browser(s) to reload the Clinqy extension." ;;
  stats|mcp|watch|replay|memory)
    # Handled by the app binary itself (no running app needed): stats [days] [--last], mcp, watch <app> <text>, replay <fixtures>, memory.
    APP=/Applications/Clinqy.app/Contents/MacOS/Clinqy
    [[ -x $APP ]] || { echo "Clinqy isn't installed (run ./build.sh in the repo)"; exit 2; }
    exec $APP "$cmd" "$@" ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
esac
