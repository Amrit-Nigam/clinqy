{
  "manifest_version": 3,
  "name": "CursorBoy",
  "version": "1.1.0",
  "description": "Lets the CursorBoy Mac app see and act on web pages precisely.",
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "CursorBoy" }
}
